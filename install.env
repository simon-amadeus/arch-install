# General system configuration
KEYMAP_INSTALL="de-latin1"                      # Keyboard layout
FONT_INSTALL="ter-132b"                         # Console font
TIMEZONE_INSTALL="Europe/Berlin"                # System timezone
LOCALE_INSTALL="en_US.UTF-8"                    # Default system locale
ADDITIONAL_LOCALES_INSTALL=("de_DE.UTF-8")      # Additional locales
HOSTNAME_INSTALL="xps"                          # System hostname

# User configuration
USERNAME="knowone"                                                  # Default username
DOTFILES_GIT_REPO="https://gitlab.com/simon.amadeus/dotfiles.git"   # User's dotfiles repository
PKG_LIST_PATH=".config/packages/pkglist.txt"                        # Path to the package list for pacman
AUR_PKG_LIST_PATH=".config/packages/aur_pkglist.txt"                # Path to the package list for AUR

# Disk partitioning
DISK="/dev/nvme0n1"                     # Disk device
BOOT_PARTITION_SIZE="512MiB"            # Size of the EFI system partition
ROOT_PARTITION_END="256GiB"             # End of the root partition
SWAP_PARTITION_END="272GiB"             # End of the swap partition

# Locale settings specifics (set these only if needed)
LC_TIME_INSTALL="de_DE.UTF-8"                   # Time format locale
LC_NUMERIC_INSTALL="de_DE.UTF-8"                # Numeric format locale
LC_MONETARY_INSTALL="de_DE.UTF-8"               # Monetary format locale
LC_PAPER_INSTALL="de_DE.UTF-8"                  # Paper format locale
LC_MEASUREMENT_INSTALL="de_DE.UTF-8"            # Measurement format locale

# Optional: Network configuration (These should be prompted during installation)
# WIFI_SSID="WIFI_SSID"                         # WiFi SSID (uncomment and set during installation)
# WIFI_PASSPHRASE="WIFI_PASSPHRASE"             # WiFi password (uncomment and set during installation)
